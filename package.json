{
  "name": "chat-thread",
  "version": "0.11.0",
  "description": "A WhatsApp-style conversation thread: bubbles by side, time and ticks, notes without a bubble for bots that narrate, safe markdown with copyable code, a growing message box, read-only and preview modes, dark, light or auto themes. Zero dependencies, vanilla JS, server-side rendering and a SQLite store for Node.",
  "keywords": [
    "chat",
    "conversation",
    "thread",
    "messages",
    "whatsapp",
    "bubbles",
    "markdown",
    "dark-mode",
    "light-theme",
    "vanilla-js",
    "sqlite",
    "no-dependencies"
  ],
  "homepage": "https://github.com/rbritta/chat-thread",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbritta/chat-thread.git"
  },
  "bugs": "https://github.com/rbritta/chat-thread/issues",
  "license": "MIT",
  "author": "rbritta",
  "type": "module",
  "main": "./src/chat-thread.js",
  "exports": {
    ".": "./src/chat-thread.js",
    "./core": "./src/core.js",
    "./style.css": "./src/chat-thread.css",
    "./server": "./server/index.js",
    "./global": "./dist/chat-thread.global.js",
    "./bundle": "./dist/chat-thread.mjs"
  },
  "files": [
    "src",
    "server",
    "dist",
    "AGENTS.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/core.js --test-coverage-include=\"server/**\" --test-coverage-include=scripts/release-notes.mjs \"test/*.test.js\"",
    "demo": "node scripts/serve-demo.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "playwright-core": "^1.48.0"
  }
}
